{
  "name": "litmus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A test runner for LLM and agent evals: run all, some, or one; live status; flaky is a first-class verdict.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lafollett-labs/litmus.git"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "litmus": "src/cli/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p ui",
    "typecheck": "npm run check",
    "test": "node scripts/test.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.8",
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@anthropic-ai/sdk": "^0.128.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
